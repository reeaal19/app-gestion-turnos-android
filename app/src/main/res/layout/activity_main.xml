<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".MainActivity">

    <!-- 1. Barra superior: Controles del Mes con el Azul Oscuro de Valorian -->
    <LinearLayout
        android:id="@+id/layoutCabecera"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:paddingTop="42dp"
        android:background="@color/valorian_azul_oscuro"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnMesAnterior"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/valorian_azul_claro"
            android:contentDescription="Mes anterior" />

        <TextView
            android:id="@+id/tvMesActual"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AGOSTO 2026"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnMesSiguiente"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/valorian_azul_claro"
            android:contentDescription="Mes siguiente" />
    </LinearLayout>

    <!-- 2. Cabecera de los días de la semana -->
    <LinearLayout
        android:id="@+id/layoutDiasSemana"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/layoutCabecera"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LUN" android:textAlignment="center" android:textStyle="bold" android:textColor="#1A1E36"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MAR" android:textAlignment="center" android:textStyle="bold" android:textColor="#1A1E36"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MIÉ" android:textAlignment="center" android:textStyle="bold" android:textColor="#1A1E36"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="JUE" android:textAlignment="center" android:textStyle="bold" android:textColor="#1A1E36"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="VIE" android:textAlignment="center" android:textStyle="bold" android:textColor="#1A1E36"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SÁB" android:textAlignment="center" android:textStyle="bold" android:textColor="#1A1E36"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DOM" android:textAlignment="center" android:textStyle="bold" android:textColor="#1A1E36"/>
    </LinearLayout>

    <!-- 3. Contenedor intermedio para la Marca de Agua y el RecyclerView -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutDiasSemana"
        app:layout_constraintBottom_toTopOf="@id/layoutNavegacionInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1º La cuadrícula de fondo -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCalendario"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#222222"
            android:paddingTop="1dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="7" />

        <!-- 2º Logo de la "V" (AL ESTAR AQUÍ ABAJO, SE DIBUJA POR ENCIMA COMO MARCA DE AGUA) -->
        <ImageView
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:src="@drawable/logo_valorian"
            android:alpha="0.08"
            android:scaleType="centerInside"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 4. Botones inferiores -->
    <LinearLayout
        android:id="@+id/layoutNavegacionInferior"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#F5F5F5"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnPintar"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="PINTAR"
            android:textColor="#1A1E36"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResumen"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="RESUMEN"
            android:textColor="#1A1E36"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTurnos"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="TURNOS"
            android:textColor="#1A1E36"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>